{
  "name": "Supply-chain demand-planning agent workshop",
  "image": "mcr.microsoft.com/devcontainers/python:3.11-bookworm",
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb"
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    }
  },
  // Port 3000 is intentionally NOT in forwardPorts. When a port is pre-declared
  // there, Codespaces sets up the tunnel at container start (before vite is
  // listening) and fires onAutoForward once at that moment — openPreview then
  // races vite's bootup, shows "can't connect", and never re-fires when vite
  // actually binds. Leaving 3000 out lets Codespaces auto-detect it the
  // instant vite starts listening, which is when we actually want the preview.
  "forwardPorts": [1521, 8000],
  "portsAttributes": {
    "1521": {
      "label": "Oracle AI Database",
      "onAutoForward": "silent"
    },
    "8000": {
      "label": "Chat app — backend (FastAPI)",
      "onAutoForward": "ignore"
    },
    "3000": {
      "label": "Chat app — frontend (Vite)",
      "onAutoForward": "openPreview"
    }
  },
  "onCreateCommand": "bash .devcontainer/setup_build.sh",
  "postCreateCommand": "bash .devcontainer/setup_runtime.sh",
  "postStartCommand": "bash .devcontainer/start_app.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter",
        "ms-azuretools.vscode-docker",
        "Oracle.oracledevtools"
      ],
      "settings": {
        "jupyter.notebookFileRoot": "${workspaceFolder}"
      }
    }
  },
  // ── Static defaults that every process in the container needs to see ─────
  // containerEnv is visible to lifecycle scripts (postStartCommand → start_app.sh)
  // AND to the VS Code terminal. remoteEnv is editor-only — it would NOT reach
  // start_app.sh, so uvicorn would launch blind to ORACLE_* and LLM_PROVIDER.
  "containerEnv": {
    "LLM_PROVIDER": "oci",
    "LLM_MODEL": "xai.grok-4-1-fast-reasoning",
    "OCI_GENAI_ENDPOINT": "https://inference.generativeai.us-phoenix-1.oci.oraclecloud.com",
    "ORACLE_USER": "AGENT",
    "ORACLE_PASSWORD": "AgentPwd_2025",
    "ORACLE_DSN": "localhost:1521/FREEPDB1"
  },
  // ── Secrets only ─────────────────────────────────────────────────────────
  // These pull from the user's local env (or Codespace user secrets configured
  // in the GitHub UI: Settings → Codespaces → Secrets). Empty values are fine
  // — the active provider's key is the one that needs to be set.
  "remoteEnv": {
    "OPENAI_API_KEY": "${localEnv:OPENAI_API_KEY}",
    "OCI_GENAI_API_KEY": "${localEnv:OCI_GENAI_API_KEY}"
  }
}
